# kc-pp-sync — Environment Variables
# Used for local development only.
# Production uses Google Secret Manager (aya-gservicies project).

# HeyPros API
HEYPROS_GRAPHQL_URL=https://hey-pros-api.birdsdontexist.com/graphql
HEYPROS_TENANT=kc-power-clean.heypros.com
HEYPROS_EMAIL=your-email@example.com
HEYPROS_PASSWORD=your-password

# Jobber OAuth (tokens auto-rotate in production via Secret Manager)
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=

# Google Sheets
SPREADSHEET_ID=your-sheet-id-here

# Dry run — set to "true" to skip actual sheet writes
SHEETS_DRY_RUN=true
