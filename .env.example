# HeyPros API
HEYPROS_GRAPHQL_URL=https://hey-pros-api.birdsdontexist.com/graphql
HEYPROS_TENANT=kc-power-clean.heypros.com
HEYPROS_EMAIL=your-email@example.com
HEYPROS_PASSWORD=your-password

# Jobber API (optional — defaults shown)
JOBBER_TOKEN_PATH=/data/.openclaw/workspace-aya-dev/kc/tokens/jobber_tokens.json
JOBBER_API_URL=https://api.getjobber.com/api/graphql
JOBBER_API_VERSION=2025-04-16
SYNC_LOOKBACK_DAYS=7

# Jobber OAuth credentials (for automatic token refresh)
# Falls back to reading from /data/.openclaw/workspace-aya-dev/kc/.env if not set here
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=

# Google Sheets (optional — if empty, a new sheet is created each run)
GOOGLE_SHEETS_DEFAULT_ID=

# Set to "true" to skip actual sheet writes
SHEETS_DRY_RUN=true
